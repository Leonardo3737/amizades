<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Amizades</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/my-btn.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/my-container.css" asp-append-version="true" />
    <link href="~/css/components/sidebar.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Amizades.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="d-flex align-items-center">
    <div class="my-container">
        <main role="main" class="pb-3">
            <div class="row">
                <div class="col-4 h-100 col-xxl-3 d-flex justify-content-center">
                    @RenderSection("SidebarLeft", required: false)
                </div>

                <div class="publication-body col-4 h-100 col-xxl-6">
                    @RenderBody()
                </div>

                <div class="col-4 h-100 col-xxl-3 d-flex justify-content-center">
                    @RenderSection("SidebarRight", required: false)
                </div>
            </div>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/components/spinner.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
