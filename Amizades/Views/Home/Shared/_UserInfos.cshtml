@model Amizades.ViewModels.HomeUserViewModel
@{
}

<div class="user-info-card">
    <div class="card-body flex-column gap-4 d-flex justify-content-between align-items-start">
        <div>
            <h5 class="card-title">@Model.Username</h5>
            <h6 class="card-subtitle mb-2 text-body-secondary">@Model.Name</h6>
            <p class="card-text">
                <span id="friend-count">@Model.Friends.Items.Count</span>
                @(@Model.Friends.Items.Count == 1 ? "Amigo" : "Amigos")
            </p>
        </div>
        <div class="w-100">
            <h4>Amigos</h4>
            @await Html.PartialAsync("./Shared/_Friends", Model.Friends)
        </div>
    </div>
</div>