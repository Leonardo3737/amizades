@model Amizades.ViewModels.PaginationViewModel<Amizades.ViewModels.FriendshipViewModel>
@{
    ViewData["type"] = "FRIEND";
}

<div class="d-flex flex-column gap-2 align-items-center overflow-auto" style="max-height: 600px;">
    <div id="friends-container" class="d-flex flex-column gap-2 align-items-center w-100">
        @if (Model.Items.Count > 0)
        {
            @await Html.PartialAsync("./Shared/_UserList", Model.Items)
        }
        else
        {
            <p>Você não possuí amigos</p>
        }
    </div>
    @if (Model.HasNextPage)
    {
        <button id="load-more-FRIEND" class="my-btn my-btn-link" onclick="loadMoreFriends()">Ver mais</button>
    }
</div>

@section Scripts {
    <script src="~/js/friendship/getFriends.js"></script>
}
