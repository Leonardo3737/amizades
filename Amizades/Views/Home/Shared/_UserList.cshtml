@model List<Amizades.ViewModels.FriendshipViewModel>
@{
    var hasNextPage = (bool)(ViewData["HasNextPage"] ?? true);
    ViewData["ShowFriends"] = false;
    ViewData["ShowInviteButton"] = true;
    var type = ViewData["type"];
}
@foreach (var user in Model)
{
    <div id="user-@user.FriendshipId-@type" class="friend-card">
        <div class="w-100 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <div>
                    <h5 style="margin-bottom: 0;">@user.Name</h5>
                    <h6 class="text-body-secondary">@@@user.Username</h6>
                </div>

            </div>

            <div>
                @if (user.Status != Amizades.Models.Enums.FriendshipStatus.Pending && type == "SUGESTION")
                {
                    <button id="invite-btn-@user.UserId" class="my-btn my-btn-outline-primary my-auto" onclick="sendingInvite(@user.UserId)">
                        Enviar Convite
                    </button>
                }
                else if (type == "REQUEST")
                {
                    <button class="my-btn my-btn-outline-primary my-auto" onclick="acceptInvite(@user.FriendshipId)">
                        Aceitar
                    </button>
                    <button class="my-btn my-btn-outline-danger" onclick="removeFriend(@user.FriendshipId, 'REQUEST')">
                        Recusar
                    </button>
                }
                else if (type == "FRIEND")
                {
                    <button class="my-btn my-btn-outline-danger" onclick="removeFriend(@user.FriendshipId, 'FRIEND')">
                        Excluir
                    </button>
                }
            </div>
        </div>
    </div>
}
@if (!hasNextPage)
{
    <div id="hide-load-more-@type"></div>
}

@section Scripts {
    <script src="~/js/friendship/actions.js"></script>
}
