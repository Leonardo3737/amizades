@model Amizades.ViewModels.PaginationViewModel<Amizades.ViewModels.FriendshipViewModel>
@{
    ViewData["type"] = "REQUEST";
}

<div class="d-flex flex-column gap-2 align-items-center">
    <div id="friendsRequest-container" class="d-flex flex-column gap-2 align-items-center w-100">
        @if (Model.Items.Count > 0)
        {
            @await Html.PartialAsync("./Shared/_UserList", Model.Items)
        }
        else
        {
            <p>Você não possuí solicitações de amizade</p>
        }
    </div>
    @if (Model.HasNextPage)
    {
        <button id="load-more-REQUEST" class="btn btn-link" onclick="loadMoreRequests()">Ver mais</button>
    }
</div>

@section Scripts {
    <script src="~/js/friendship/getFriendRequest.js"></script>
}
