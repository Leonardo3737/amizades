@model List<Amizades.ViewModels.PublicationViewModel>

@{
    var hasNextPage = (bool)(ViewData["hasNextPage"] ?? true);
}

@foreach (var publication in Model)
{
    <div class="publication-card publication-card-background w-100">
        <div class="d-flex flex-column justify-content-between">
            <div class="publication-header">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="publication-author-name">@publication.AuthorName</h5>
                    <h4 class="publication-username">@@@publication.AuthorUsername</h4>
                </div>
                <p class="publication-date">@publication.CreatedAt.ToString("d 'de' MMMM 'às' HH:mm", new System.Globalization.CultureInfo("pt-BR"))</p>
            </div>
            <p class="publication-text">@publication.PublicationText</p>
        </div>
    </div>
}

@if (!hasNextPage)
{
    <div id="hide-load-more-PUBLICATIONS"></div>
}

